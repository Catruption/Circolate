# ── Rust build output ──────────────────────────────────────────
/target/

# ── Large SoundFonts ───────────────────────────────────────────
# Users install their own (FluidR3 lives at /usr/share/soundfonts/
# on most distros).  Do not ship 148 MB banks in the repo.
/soundfonts/
/plugins/
/music/
/share/plugins/
# ── Trackscript extractions ────────────────────────────────────
# The .tsz is the canonical artifact; extracted directories are
# working copies.  Town/ is committed deliberately, so this stays
# commented.  Uncomment to ignore all of them:
# /trackscripts/*/

# ── Editor / OS cruft ──────────────────────────────────────────
desktop.ini
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.orig
*.rej

# ── Stray flag-parse artifacts ─────────────────────────────────
# `run.sh --some-flag` (with the flag's value missing) writes a file
# named after the flag at cwd.  Anything starting with a dash is an
# accident.
/-*

# ── Local scratch ──────────────────────────────────────────────
*.tmp
*.bak
/trackscripts/*.tsz

# ── Generated data files ───────────────────────────────────────
/share/plugins_inventory.json
/share/required_plugins.json
/system (ignore)/
/share/soundfonts/
/share/soundfonts/
/share/circolate/trackscripts/no villains.tsz
/share/circolate/trackscripts/Carol Roll.tsz
